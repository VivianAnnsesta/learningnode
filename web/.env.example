DATABASE_URL="file:./dev.db"

# AI provider options:
# - openai: OpenAI cloud API, requires AI_API_KEY or OPENAI_API_KEY
# - qwen: Alibaba Cloud Model Studio / DashScope OpenAI-compatible API, requires DASHSCOPE_API_KEY, QWEN_API_KEY, or AI_API_KEY
# - deepseek: DeepSeek OpenAI-compatible API, requires DEEPSEEK_API_KEY or AI_API_KEY
# - lmstudio: local LM Studio OpenAI-compatible server, default base URL http://localhost:1234/v1
# - openai-compatible: any OpenAI-compatible endpoint
AI_PROVIDER="lmstudio"
AI_BASE_URL="http://localhost:1234/v1"
AI_MODEL="your-loaded-model-id"
AI_API_KEY=""
OPENAI_API_KEY=""
DASHSCOPE_API_KEY=""
QWEN_API_KEY=""
DEEPSEEK_API_KEY=""
AI_TEMPERATURE="0.25"
AI_TIMEOUT_MS="45000"
# Optional, range: 1-131072
AI_MAX_TOKENS="1800"

# Course-design research uses a web-capable network model.
# For AI_PROVIDER=openai, the app adds the OpenAI web_search_preview tool by default
# on course_design_research and course_design_repair tasks.
# Set this to true only when you need to disable that OpenAI hosted search tool.
AI_DISABLE_OPENAI_WEB_SEARCH="false"

# For other OpenAI-compatible providers, inject provider-specific search options here.
# Example:
# AI_RESEARCH_EXTRA_BODY_JSON="{\"web_search_options\":{\"search_context_size\":\"high\"}}"
AI_RESEARCH_EXTRA_BODY_JSON=""

# Verification commands:
# npm run verify:ai-provider
# npm run verify:ai-provider:lmstudio -- --base-url http://localhost:1234/v1 --model your-loaded-model-id
# npm run verify:ai-provider:openai -- --model gpt-4o-mini --api-key sk-...
# npm run verify:ai-provider:qwen -- --model qwen-plus --api-key sk-...
# npm run verify:ai-provider:deepseek -- --model deepseek-v4-pro --api-key sk-...
